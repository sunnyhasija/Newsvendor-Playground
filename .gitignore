# Specific Project Exclusions
# ===========================

# Keep important configuration templates
!config/experiment.yaml
!config/models.yaml  
!config/prompts.yaml

# Keep source code and core files
!src/
!*.py
!*.md
!*.yaml
!*.yml
!*.toml
!*.lock
!Makefile
!LICENSE
!README*

# Keep documentation
!docs/
!*.rst
!*.txt

# Special Cases
# =============

# Allow specific result files that are meant to be tracked
# (uncomment if needed for specific files)
# !important_results.json
# !baseline_results.csv

